# 4e94:4e09
# Ajustes para el Teclado Reviung 53, parece que la interacción entre linux y el control de energía de los dispositivos USB es medio
# aja conflictiva :v
SUBSYSTEM=="usb", ATTR{idVendor}=="4e94", ATTR{idProduct}=="4e09", TEST=="power/control", ATTR{power/control}="on"
SUBSYSTEM=="usb", ATTR{idVendor}=="4e94", ATTR{idProduct}=="4e09", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
